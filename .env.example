# Copier vers .env.local pour le dev local (jamais commité — voir .gitignore).
# En production/preview, ces mêmes noms se saisissent dans Vercel :
# Project Settings → Environment Variables.

# Supabase — Dashboard du projet → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe — Payment Link créé dans le Dashboard Stripe (Payment Links → Create)
STRIPE_PAYMENT_LINK=

# URL canonique du site déployé (sans slash final), utilisée pour l'Open
# Graph et le lien "retour à l'accueil" de la page succès.
# Preview Vercel : laisser vide (le build utilisera le domaine *.vercel.app
# généré automatiquement) ou renseigner l'URL de preview si besoin d'un test
# exact. Production : https://coldtrend.com
NEXT_PUBLIC_SITE_URL=
